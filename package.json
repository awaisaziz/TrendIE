{
  "name": "trendie-qpe",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/contracts",
    "packages/inspection",
    "packages/agent",
    "packages/qatom",
    "packages/goat",
    "apps/web"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "web:dev": "npm --workspace @trendie/web run dev",
    "web:build": "npm --workspace @trendie/web run build",
    "web:typecheck": "npm --workspace @trendie/web run typecheck",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "gateway:typecheck": "npm --prefix gateway run typecheck",
    "gateway:lint": "npm --prefix gateway run lint",
    "gateway:build": "npm --prefix gateway run build",
    "gateway:dev": "npm --prefix gateway run dev",
    "gateway:test:unit": "npm --prefix gateway run test:unit",
    "db:up": "docker compose -f gateway/docker-compose.yml up -d",
    "db:down": "docker compose -f gateway/docker-compose.yml down",
    "db:migrate": "npm --prefix gateway run db:migrate",
    "db:seed": "npm --prefix gateway run db:seed",
    "test:pdf": "python3 -m unittest discover -s services/pdf-inspection",
    "demo:attack": "node scripts/demo-attack.mjs",
    "demo:goat": "node scripts/demo-goat-live.mjs",
    "demo:pdf": "node scripts/demo-pdf-attack.mjs",
    "demo:replay": "node scripts/demo-replay-attack.mjs",
    "demo:audit": "node scripts/demo-audit-integrity.mjs",
    "qatom:probe": "node packages/qatom/dist/cli.js",
    "demo:controlled": "node scripts/demo-controlled-comparison.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "eslint": "^10.15.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.0",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.8"
    }
  }
}
