# Server
PORT=3000
HOST=127.0.0.1
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/payment_guard
TEST_DATABASE_URL=postgresql://postgres:password@localhost:5432/payment_guard_test

# Secrets
# Generate every secret below separately, for example:  openssl rand -hex 32
# Never commit real values, paste them into chat, or reuse one value in two slots.
# With NODE_ENV=production the gateway refuses to start if any secret is shorter than
# 32 characters, still a placeholder, or shared between a signing key and an API key.

# Approvals & HMAC
APPROVAL_HMAC_SECRET=replace-with-hmac-secret-openssl-rand-hex-32
APPROVAL_KEY_ID=key_v1
APPROVAL_TTL_SECONDS=300
# Signing-key rotation: move the old pair here as keyId:secret (comma-separated), then set a
# new APPROVAL_KEY_ID and APPROVAL_HMAC_SECRET. Remove an entry to invalidate its approvals.
APPROVAL_HMAC_PREVIOUS_KEYS=

# Service API Keys (per role)
API_KEY_AGENT=replace-with-agent-key
API_KEY_ADAPTER_GOAT=replace-with-goat-adapter-key
API_KEY_ADAPTER_QATOM=replace-with-qatom-adapter-key
API_KEY_DASHBOARD=replace-with-dashboard-key
API_KEY_ADMIN=replace-with-admin-key
# Human review approver. Leave empty and only the admin key can resolve reviews.
API_KEY_APPROVER=

# Service-key rotation: put the outgoing key in the matching *_PREVIOUS slot (comma-separated)
# so callers can switch without downtime, then clear it.
API_KEY_AGENT_PREVIOUS=
API_KEY_ADAPTER_GOAT_PREVIOUS=
API_KEY_ADAPTER_QATOM_PREVIOUS=
API_KEY_DASHBOARD_PREVIOUS=
API_KEY_ADMIN_PREVIOUS=
API_KEY_APPROVER_PREVIOUS=
# Leaked key: add its SHA-256 hex fingerprint here (comma-separated) and restart. It is then
# refused even if it is still present in a slot above.
#   printf '%s' "$LEAKED_KEY" | sha256sum
API_KEYS_REVOKED_SHA256=

# Throttling (per process, in memory)
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_SECONDS=60
AUTH_FAILURE_MAX=20

# Owner principal bound to each key. GOAT authority routes take the owner only from here.
# A key with no owner gets 403 OWNER_UNBOUND on owner-scoped GOAT routes.
API_KEY_ADAPTER_GOAT_OWNER_ID=
API_KEY_DASHBOARD_OWNER_ID=
API_KEY_ADMIN_OWNER_ID=

# GOAT spend authorization recorded by the server. Ceiling 0 (default) blocks every GOAT claim.
GOAT_SPEND_AUTHORIZATION_ID=
GOAT_SPEND_CEILING_WEI=0
# Optional rolling 24-hour GOAT limit per owner, in wei. Pending and unknown payments count as spent.
GOAT_DAILY_LIMIT_WEI=
API_KEY_AGENT_OWNER_ID=
API_KEY_ADAPTER_QATOM_OWNER_ID=
API_KEY_APPROVER_OWNER_ID=
# Every owner-visible route (intents, verify, history, audit, executions, approvals, reviews)
# filters by the key's bound owner. For the single-owner demo, set every *_OWNER_ID above to the
# web app's DEMO_OWNER_ID. A key without an owner gets 403 OWNER_UNBOUND.

# Qatom USD-TDN limits in minor units (scale 3: 1000 = 1.000 USD-TDN). Ceiling 0 blocks every claim.
QATOM_SPEND_CEILING=0
QATOM_DAILY_LIMIT=
